# Copy to apps/api/.env (cp .env.example apps/api/.env). No real secrets here.
DATABASE_URL="postgresql://commonhours:commonhours@localhost:5432/commonhours?schema=public"
# Separate database used by `npm test` (created automatically by the test setup if missing).
TEST_DATABASE_URL="postgresql://commonhours:commonhours@localhost:5432/commonhours_test?schema=public"
# Use a long random string in any shared deployment.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
API_PORT=4000
WEB_ORIGIN="http://localhost:5173"
# Demo mode enables the account switcher, simulated clock, reset button and reproducible attestor seeds.
DEMO_MODE=true
# Development-only debug endpoints (/api/debug/*). Never enable in production.
DEBUG_ENDPOINTS=true
# Public URL used for links in notification emails.
APP_BASE_URL="http://localhost:5173"
# Daily job at 00:00 Asia/Hong_Kong (credit expiry → community pool → negative-balance reminders).
# Set to false when an external cron runs `npx tsx apps/api/scripts/run-daily-job.ts` instead.
DAILY_JOB_SCHEDULER=true
# Optional email delivery (credentials stay on the backend). Leave unset to disable:
# demo mode then shows email previews, otherwise emails are recorded as skipped.
# University email codes are shown as previews only in development (never when NODE_ENV=production).
# Gmail: an App Password (account with 2-Step Verification) or OAuth2 (client id/secret/refresh token).
# EMAIL_PROVIDER="gmail"
# EMAIL_FROM="CommonHours <your.address@gmail.com>"
# GMAIL_USER="your.address@gmail.com"
# GMAIL_APP_PASSWORD=""
# GMAIL_CLIENT_ID=""
# GMAIL_CLIENT_SECRET=""
# GMAIL_REFRESH_TOKEN=""
# Any other SMTP server:
# EMAIL_PROVIDER="smtp"
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""

# Copy to apps/api/.env (cp .env.example apps/api/.env). No real secrets here.
DATABASE_URL="postgresql://commonhours:commonhours@localhost:5432/commonhours?schema=public"
# Separate database used by `npm test` (created automatically by the test setup if missing).
TEST_DATABASE_URL="postgresql://commonhours:commonhours@localhost:5432/commonhours_test?schema=public"
# Use a long random string in any shared deployment.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
API_PORT=4000
WEB_ORIGIN="http://localhost:5173"
# Demo mode enables the account switcher, simulated clock, reset button and reproducible attestor seeds.
DEMO_MODE=true
# Development-only debug endpoints (/api/debug/*). Never enable in production.
DEBUG_ENDPOINTS=true

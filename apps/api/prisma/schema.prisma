// CommonHours data model.
// Money-like values (credits) are Int in hundredths of a credit (1 credit = 100).
// Timestamps that describe business events use the (possibly simulated) domain clock,
// so the demo clock can be advanced reproducibly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── members & auth ─────────────────────────

enum MemberStatus {
  ACTIVE
  LEFT
}

enum AccountType {
  STANDARD
  STUDENT
}

/// How the member joined: with an invitation (vouched by the inviter) or as a student without one.
enum JoinRoute {
  INVITATION
  STUDENT
}

model Member {
  id           String       @id @default(cuid())
  handle       String       @unique
  displayName  String
  email        String       @unique
  passwordHash String
  bio          String       @default("")
  skills       String[]
  location     String       @default("")
  status       MemberStatus @default(ACTIVE)
  /// The bootstrap member founded the community without a voucher (documented in README).
  isBootstrap  Boolean      @default(false)
  joinedAt     DateTime
  leftAt       DateTime?
  leaveReason  String?
  createdAt    DateTime     @default(now())

  // Profile (self-reported unless the name says "Verified"). Email/phone/address are private by default.
  photoUrl                 String?
  affiliation              String    @default("")
  languages                String[]  @default([])
  availability             String    @default("")
  /// Address used for contact + notifications. Falls back to the login email when null.
  contactEmail             String?
  /// Set only by the email-verification flow (a code sent to the address and confirmed).
  contactEmailVerifiedAt   DateTime?
  /// "email-code" (code delivered by a configured email provider) or "demo-preview" (demo mode:
  /// the code was shown in the on-screen email preview, so mailbox ownership was NOT proven).
  contactEmailVerifiedVia  String?
  phone                    String?
  /// No SMS provider is configured, so nothing sets this yet (phone always shows "not verified").
  phoneVerifiedAt          DateTime?
  /// Exact address. Shown only to the provider of an accepted in-home exchange.
  homeAddress              String?
  shareContactWithPartners Boolean   @default(false)
  juryAvailable            Boolean   @default(true)
  profileUpdatedAt         DateTime?
  // Notification preferences: email delivery is opt-in.
  emailNotifications       Boolean   @default(false)
  emailCategories          String[]  @default([])

  // Student details (see modules/student). The university → domain mapping lives in
  // packages/shared/src/universities.ts; the API re-validates it on every write.
  accountType             AccountType @default(STANDARD)
  /// University code, e.g. "HKU". Public on the profile.
  university              String?
  /// Private. Unique so one university mailbox cannot verify several accounts.
  studentEmail            String?     @unique
  /// Set only by the student email verification flow; cleared whenever university/email change.
  studentEmailVerifiedAt  DateTime?
  /// "email-code" (delivered by a configured provider) or "dev-preview" (development only).
  studentEmailVerifiedVia String?
  /// Self-declared current enrolment, separate from email ownership.
  studentDeclaredAt       DateTime?

  // Admission (see modules/verification). Invited members are admitted by their invitation;
  // student-route members by genuine university email verification (or the demo-mode bypass).
  joinRoute           JoinRoute @default(INVITATION)
  /// Set the first time the account used the DEMO_MODE verification bypass. Recorded separately
  /// from genuine verification and never read to grant access (demo off = genuine rules again).
  demoAdmittedAt      DateTime?
  demoAdmissionReason String?

  invitationsSent      Invitation[]            @relation("InvitationInviter")
  invitationAccepted   Invitation?             @relation("InvitationAcceptedBy")
  vouchesGiven         Vouch[]                 @relation("Voucher")
  vouchesReceived      Vouch[]                 @relation("Vouchee")
  amendmentsProposed   VouchAmendment[]
  listings             Listing[]
  exchangesProviding   Exchange[]              @relation("ExchangeProvider")
  exchangesReceiving   Exchange[]              @relation("ExchangeRecipient")
  exchangesProposed    Exchange[]              @relation("ExchangeProposer")
  ledgerAccount        LedgerAccount?
  creditLots           CreditLot[]
  disputesOpened       Dispute[]
  evidence             Evidence[]
  assignments          AttestorAssignment[]
  conflictsDeclared    ConflictDeclaration[]   @relation("ConflictDeclarer")
  conflictsAgainst     ConflictDeclaration[]   @relation("ConflictOther")
  penalties            CredibilityPenalty[]
  credibilitySnapshots CredibilitySnapshot[]
  auditEvents          AuditEvent[]
  earnedAsA            EarnedRelationship[]    @relation("EarnedA")
  earnedAsB            EarnedRelationship[]    @relation("EarnedB")
  skillClaims          SkillClaim[]
  skillReviews         SkillReview[]
  emailVerifications   EmailVerification[]
  notifications        Notification[]
  emailOutbox          EmailOutbox[]
  poolGrants           PoolGrant[]
  negativePeriods      NegativeBalancePeriod[]
  circleMemberships    CircleMembership[]
  circleMessages       CircleMessage[]
}

// ───────────────────────── invitations & vouches ─────────────────────────

enum InvitationStatus {
  OPEN
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invitation {
  id           String           @id @default(cuid())
  code         String           @unique
  inviterId    String
  inviter      Member           @relation("InvitationInviter", fields: [inviterId], references: [id])
  inviteeName  String
  /// Proposed vouch strength and liability the inviter consented to when issuing the invite.
  strength     Float
  liabilityPct Int
  termsVersion String
  status       InvitationStatus @default(OPEN)
  createdAt    DateTime
  expiresAt    DateTime
  acceptedById String?          @unique
  acceptedBy   Member?          @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id])
  acceptedAt   DateTime?
  vouch        Vouch?
}

enum VouchStatus {
  PENDING
  ACTIVE
  DECLINED
  EXPIRED
  REVOKED
}

enum VouchOrigin {
  INVITATION
  DIRECT
}

/// Directed edge voucher -> vouchee.
model Vouch {
  id                String               @id @default(cuid())
  voucherId         String
  voucher           Member               @relation("Voucher", fields: [voucherId], references: [id])
  voucheeId         String
  vouchee           Member               @relation("Vouchee", fields: [voucheeId], references: [id])
  strength          Float
  liabilityPct      Int
  status            VouchStatus
  origin            VouchOrigin
  invitationId      String?              @unique
  invitation        Invitation?          @relation(fields: [invitationId], references: [id])
  termsVersion      String
  createdAt         DateTime
  voucherConsentAt  DateTime
  voucheeConsentAt  DateTime?
  activatedAt       DateTime?
  lastInteractionAt DateTime?
  expiresAt         DateTime?
  endedAt           DateTime?
  endReason         String?
  amendments        VouchAmendment[]
  penalties         CredibilityPenalty[]

  @@index([voucherId])
  @@index([voucheeId])
}

enum AmendmentStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// A proposed change to strength/liability. Requires the counterparty's fresh consent.
model VouchAmendment {
  id               String          @id @default(cuid())
  vouchId          String
  vouch            Vouch           @relation(fields: [vouchId], references: [id])
  proposedById     String
  proposedBy       Member          @relation(fields: [proposedById], references: [id])
  fromStrength     Float
  toStrength       Float
  fromLiabilityPct Int
  toLiabilityPct   Int
  status           AmendmentStatus @default(PENDING)
  createdAt        DateTime
  decidedAt        DateTime?
}

// ───────────────────────── listings & exchanges ─────────────────────────

enum ListingType {
  OFFER
  REQUEST
}

enum ListingStatus {
  OPEN
  WITHDRAWN
  CLOSED
}

enum LocationType {
  ONLINE
  IN_PERSON
}

/// STANDARD: online / public / basic help. RESTRICTED: in someone's home while they are present.
/// HIGH_TRUST: entering someone's home while the owner is absent.
enum TrustTier {
  STANDARD
  RESTRICTED
  HIGH_TRUST
}

enum SkillTier {
  STANDARD
  SKILLED
  ADVANCED
  SPECIALIST
}

model Listing {
  id                   String        @id @default(cuid())
  type                 ListingType
  title                String
  description          String
  category             String
  ownerId              String
  owner                Member        @relation(fields: [ownerId], references: [id])
  durationMinutes      Int
  locationType         LocationType
  location             String        @default("")
  availability         String
  requiredSkills       String[]
  /// Lightweight topic tags for discovery (TOPIC_TAGS in packages/shared). Never affect price or eligibility.
  tags                 String[]      @default([])
  /// Access level of the task (see POLICY.taskEligibility). Requests set it for their own home.
  trustTier            TrustTier     @default(STANDARD)
  /// Requester-raised minimums (never below the tier/category minimum).
  minCredibility       Int?
  minRelationshipTrust Float?
  /// Requester's maximum total credits (service + gift), hundredths.
  maxCreditBudget      Int?
  status               ListingStatus @default(OPEN)
  createdAt            DateTime
  updatedAt            DateTime
  withdrawnAt          DateTime?
  exchanges            Exchange[]

  @@index([status, category])
}

enum ExchangeStatus {
  PROPOSED
  ACCEPTED
  DISPUTED
  SETTLED
  RELEASED
  CANCELLED
  DECLINED
  WITHDRAWN
}

/// Agreed work between a provider and a recipient. Separate from the listing it came from.
model Exchange {
  id                        String         @id @default(cuid())
  listingId                 String?
  listing                   Listing?       @relation(fields: [listingId], references: [id])
  linkedExchangeId          String?
  providerId                String
  provider                  Member         @relation("ExchangeProvider", fields: [providerId], references: [id])
  recipientId               String
  recipient                 Member         @relation("ExchangeRecipient", fields: [recipientId], references: [id])
  proposerId                String
  proposer                  Member         @relation("ExchangeProposer", fields: [proposerId], references: [id])
  deliverable               String
  category                  String
  durationMinutes           Int
  scheduledAt               DateTime
  location                  String         @default("")
  punctualityRequired       Boolean
  /// Standard amount derived from duration (1h = 1 credit), in hundredths.
  creditAmount              Int
  /// Voluntary gift from the recipient, recorded and agreed before work starts.
  giftBonus                 Int            @default(0)
  cancellationNoticeHours   Int
  cancellationTerms         String         @default("")
  confirmationDeadline      DateTime
  status                    ExchangeStatus
  termsVersion              Int            @default(1)
  providerAcceptedAt        DateTime?
  recipientAcceptedAt       DateTime?
  acceptedAt                DateTime?
  providerConfirmedAt       DateTime?
  recipientConfirmedAt      DateTime?
  settledAt                 DateTime?
  settledAmount             Int?
  closedAt                  DateTime?
  cancelRequestedById       String?
  cancelRequestedAt         DateTime?
  cancelReason              String?
  partialAmount             Int?
  partialProposedById       String?
  partialNote               String?
  /// Direct vouches that were active for each party when the exchange was accepted.
  /// Liability penalties use this snapshot so a later revocation cannot erase accountability.
  liabilitySnapshot         Json?
  // Task eligibility (requester-controlled; provider edits cannot change these).
  trustTier                 TrustTier      @default(STANDARD)
  minCredibility            Int?
  minRelationshipTrust      Float?
  /// Explicit home-access approval by the recipient (owner), valid for one terms version.
  homeAccessApprovedAt      DateTime?
  homeAccessApprovedVersion Int?
  /// Eligibility checks recorded when the exchange was accepted.
  eligibilitySnapshot       Json?
  // Pricing. Legacy exchanges (before premium pricing) have baseCredits = null and creditAmount = hours.
  maxCreditBudget           Int?
  baseCredits               Int?
  skillTier                 SkillTier?
  /// Multipliers in hundredths (125 = ×1.25).
  skillMultiplierPct        Int?
  demandMultiplierPct       Int?
  /// Quote for the current terms version (both parties accept this exact price).
  pricingQuote              Json?
  /// Frozen copy of the quote at acceptance. Never recomputed.
  priceSnapshot             Json?
  priceLockedAt             DateTime?
  createdAt                 DateTime
  updatedAt                 DateTime
  reservation               Reservation?
  dispute                   Dispute?
  trustUpdate               TrustUpdate?

  @@index([providerId])
  @@index([recipientId])
  @@index([status])
}

// ───────────────────────── ledger ─────────────────────────

enum LedgerAccountType {
  MEMBER
  /// Legacy: expired credits before the community pool existed (kept for history).
  SYSTEM_EXPIRY
  SYSTEM_ADJUSTMENT
  /// Shared Community Credit Pool: receives expired credits, pays daily redistributions. Never expires.
  SYSTEM_COMMUNITY_POOL
}

model LedgerAccount {
  id        String            @id @default(cuid())
  type      LedgerAccountType
  memberId  String?           @unique
  member    Member?           @relation(fields: [memberId], references: [id])
  name      String
  createdAt DateTime          @default(now())
  entries   LedgerEntry[]
}

enum LedgerTxKind {
  SETTLEMENT
  EXPIRY
  ADJUSTMENT
  POOL_DISTRIBUTION
}

/// A balanced group of entries (sum of amounts = 0).
model LedgerTransaction {
  id             String        @id @default(cuid())
  kind           LedgerTxKind
  /// Prevents double posting, e.g. "settle:<exchangeId>".
  idempotencyKey String        @unique
  exchangeId     String?
  explanation    String
  ruleId         String
  policyVersion  String
  correlationId  String
  effectiveAt    DateTime
  createdAt      DateTime      @default(now())
  entries        LedgerEntry[]
  lots           CreditLot[]
}

model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  accountId     String
  account       LedgerAccount     @relation(fields: [accountId], references: [id])
  amount        Int
  explanation   String
  effectiveAt   DateTime

  @@index([accountId])
}

enum ReservationStatus {
  ACTIVE
  FROZEN
  SETTLED
  RELEASED
}

/// Reduces the payer's available balance without paying the provider.
model Reservation {
  id             String            @id @default(cuid())
  exchangeId     String            @unique
  exchange       Exchange          @relation(fields: [exchangeId], references: [id])
  payerId        String
  payeeId        String
  amount         Int
  giftBonus      Int               @default(0)
  status         ReservationStatus
  createdAt      DateTime
  updatedAt      DateTime
  resolvedAt     DateTime?
  resolutionNote String?

  @@index([payerId, status])
  @@index([payeeId, status])
}

/// Dated positive credits. Invariant: sum(remaining) == max(posted balance, 0).
model CreditLot {
  id                  String            @id @default(cuid())
  memberId            String
  member              Member            @relation(fields: [memberId], references: [id])
  sourceTransactionId String
  sourceTransaction   LedgerTransaction @relation(fields: [sourceTransactionId], references: [id])
  earnedAt            DateTime
  expiresAt           DateTime
  originalAmount      Int
  remaining           Int

  @@index([memberId, earnedAt])
}

// ───────────────────────── disputes & attestation ─────────────────────────

enum DisputeStatus {
  AWAITING_ATTESTATION
  PANEL_REVIEW
  NEEDS_REVIEW
  RESOLVED
}

enum DisputeOutcome {
  CONFIRMED
  REFUTED
}

enum DisputeCondition {
  DELIVERABLE
  DURATION
  PUNCTUALITY
  NO_SHOW
}

model Dispute {
  id                    String               @id @default(cuid())
  exchangeId            String               @unique
  exchange              Exchange             @relation(fields: [exchangeId], references: [id])
  openedById            String
  openedBy              Member               @relation(fields: [openedById], references: [id])
  condition             DisputeCondition
  claim                 String
  status                DisputeStatus
  /// 1 = single attestor, 2 = panel of three.
  stage                 Int                  @default(1)
  outcome               DisputeOutcome?
  outcomeSource         String?
  reviewReason          String?
  nextAction            String?
  voteDeadline          DateTime?
  mutualProposalById    String?
  mutualProposalOutcome DisputeOutcome?
  createdAt             DateTime
  resolvedAt            DateTime?
  evidence              Evidence[]
  selections            AttestorSelection[]
  assignments           AttestorAssignment[]
  penalties             CredibilityPenalty[]
}

model Evidence {
  id        String   @id @default(cuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id])
  authorId  String
  author    Member   @relation(fields: [authorId], references: [id])
  kind      String
  content   String
  createdAt DateTime
}

/// Record of every random selection: seed, candidates, exclusions and result.
model AttestorSelection {
  id            String   @id @default(cuid())
  disputeId     String
  dispute       Dispute  @relation(fields: [disputeId], references: [id])
  round         Int
  stage         Int
  seed          String
  candidates    Json
  selectedIds   String[]
  requiredCount Int
  sufficient    Boolean
  /// "random-v1" (older rows) or "lowest-closeness-v2".
  method        String   @default("random-v1")
  createdAt     DateTime
}

enum AssignmentStatus {
  ASSIGNED
  VOTED
  RECUSED
  MISSED
  NOT_NEEDED
}

enum VoteChoice {
  CONFIRMED
  REFUTED
  UNCLEAR
}

model AttestorAssignment {
  id         String           @id @default(cuid())
  disputeId  String
  dispute    Dispute          @relation(fields: [disputeId], references: [id])
  round      Int
  stage      Int
  attestorId String
  attestor   Member           @relation(fields: [attestorId], references: [id])
  status     AssignmentStatus @default(ASSIGNED)
  vote       VoteChoice?
  reason     String?
  votedAt    DateTime?
  createdAt  DateTime

  @@unique([disputeId, attestorId])
}

model ConflictDeclaration {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation("ConflictDeclarer", fields: [memberId], references: [id])
  otherMemberId String
  otherMember   Member   @relation("ConflictOther", fields: [otherMemberId], references: [id])
  reason        String
  createdAt     DateTime

  @@unique([memberId, otherMemberId])
}

// ───────────────────────── credibility ─────────────────────────

enum PenaltyKind {
  NONPERFORMANCE_FINDING
  VOUCH_LIABILITY
  MISCONDUCT_FINDING
}

/// Only created from a documented, finalized finding.
model CredibilityPenalty {
  id        String      @id @default(cuid())
  memberId  String
  member    Member      @relation(fields: [memberId], references: [id])
  kind      PenaltyKind
  points    Int
  disputeId String?
  dispute   Dispute?    @relation(fields: [disputeId], references: [id])
  vouchId   String?
  vouch     Vouch?      @relation(fields: [vouchId], references: [id])
  finding   String
  ruleId    String
  createdAt DateTime
}

/// History of computed scores. The score itself is always recomputed from records.
model CredibilitySnapshot {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  score     Float
  breakdown Json
  reason    String
  createdAt DateTime

  @@index([memberId, createdAt])
}

// ───────────────────────── earned trust ─────────────────────────

/// Undirected relationship earned through exchanges both members confirmed in full.
/// Distinct from vouches: it carries NO liability and is never created by an invitation.
/// memberAId < memberBId (string order) so each pair has one row.
model EarnedRelationship {
  id               String        @id @default(cuid())
  memberAId        String
  memberA          Member        @relation("EarnedA", fields: [memberAId], references: [id])
  memberBId        String
  memberB          Member        @relation("EarnedB", fields: [memberBId], references: [id])
  strength         Float
  countedExchanges Int           @default(0)
  createdAt        DateTime
  lastExchangeAt   DateTime
  updatedAt        DateTime
  updates          TrustUpdate[]

  @@unique([memberAId, memberBId])
}

/// One row per eligible exchange (unique exchangeId = the increase is applied exactly once).
model TrustUpdate {
  id                      String             @id @default(cuid())
  relationshipId          String
  relationship            EarnedRelationship @relation(fields: [relationshipId], references: [id])
  exchangeId              String             @unique
  exchange                Exchange           @relation(fields: [exchangeId], references: [id])
  previousStrength        Float
  newStrength             Float
  /// false when a limit (cap, pair window) meant no increase.
  applied                 Boolean
  reason                  String
  relationshipTrustBefore Float?
  relationshipTrustAfter  Float?
  ruleId                  String
  createdAt               DateTime

  @@index([relationshipId, createdAt])
}

// ───────────────────────── skills & pricing ─────────────────────────

enum SkillClaimStatus {
  PENDING
  APPROVED
  DECLINED
}

/// A member asks for a higher skill tier in one category. Self-claims never raise the price
/// on their own; only APPROVED claims (peer review) or the record-based rule do.
model SkillClaim {
  id        String           @id @default(cuid())
  memberId  String
  member    Member           @relation(fields: [memberId], references: [id])
  category  String
  tier      SkillTier
  evidence  String
  status    SkillClaimStatus @default(PENDING)
  createdAt DateTime
  decidedAt DateTime?
  reviews   SkillReview[]

  @@index([memberId, category])
}

model SkillReview {
  id         String     @id @default(cuid())
  claimId    String
  claim      SkillClaim @relation(fields: [claimId], references: [id])
  reviewerId String
  reviewer   Member     @relation(fields: [reviewerId], references: [id])
  approve    Boolean
  note       String
  createdAt  DateTime

  @@unique([claimId, reviewerId])
}

// ───────────────────────── profiles & notifications ─────────────────────────

model EmailVerification {
  id         String    @id @default(cuid())
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id])
  /// "contact" (profile contact email) or "student" (university email). Flows never consume each other's codes.
  purpose    String    @default("contact")
  address    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime

  @@index([memberId, createdAt])
}

/// Persistent in-app notification. dedupeKey prevents the same event notifying twice.
model Notification {
  id         String       @id @default(cuid())
  memberId   String
  member     Member       @relation(fields: [memberId], references: [id])
  kind       String
  category   String
  title      String
  body       String
  link       String?
  entityType String?
  entityId   String?
  dedupeKey  String       @unique
  readAt     DateTime?
  /// Domain (possibly simulated) time of the event.
  createdAt  DateTime
  email      EmailOutbox?

  @@index([memberId, createdAt])
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  PREVIEW
  SKIPPED
}

/// Persisted outbox: rows are written after the business transaction commits and delivered
/// (with retries) by the email adapter. A failure here never affects the business change.
model EmailOutbox {
  id             String        @id @default(cuid())
  notificationId String?       @unique
  notification   Notification? @relation(fields: [notificationId], references: [id])
  memberId       String
  member         Member        @relation(fields: [memberId], references: [id])
  toAddress      String
  subject        String
  body           String
  dedupeKey      String        @unique
  status         EmailStatus
  provider       String
  attempts       Int           @default(0)
  lastError      String?
  nextAttemptAt  DateTime
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, nextAttemptAt])
  @@index([memberId, createdAt])
}

// ───────────────────────── community pool, daily job, negative balances ─────────────────────────

/// One row per Hong Kong calendar date. The unique runDate makes the daily job run at most once
/// per date; a FAILED or stale RUNNING row is re-claimed by the next attempt (every step is idempotent).
model DailyJobRun {
  id           String    @id @default(cuid())
  /// YYYY-MM-DD in POLICY.schedule.timezone (the date whose 00:00 triggered the run).
  runDate      String    @unique
  /// Domain time of that date's 00:00.
  scheduledFor DateTime
  /// RUNNING | COMPLETED | FAILED
  status       String
  /// scheduler | clock-advance | manual | cli
  trigger      String
  attempts     Int       @default(1)
  /// Wall-clock times (used to detect a crashed worker).
  startedAt    DateTime
  completedAt  DateTime?
  lastError    String?
  steps        Json?
}

/// One distribution per date (unique runDate): the snapshot of every input and the exact arithmetic.
model PoolDistribution {
  id                  String      @id @default(cuid())
  runDate             String      @unique
  /// PAID | RETAINED_NO_ACTIVE_USERS | RETAINED_TOO_SMALL
  status              String
  /// Hundredths of a credit (the ledger's unit).
  poolBefore          Int
  activeUserCount     Int
  recipientCount      Int
  paymentPerRecipient Int
  totalPaid           Int
  remaining           Int
  seed                String
  windowStart         String
  windowEnd           String
  /// Scores, tie order, selection and formula used.
  inputs              Json
  createdAt           DateTime
  grants              PoolGrant[]
}

/// One payment to one member in one distribution (unique per distribution + member).
model PoolGrant {
  id                  String           @id @default(cuid())
  distributionId      String
  distribution        PoolDistribution @relation(fields: [distributionId], references: [id])
  memberId            String
  member              Member           @relation(fields: [memberId], references: [id])
  amount              Int
  rank                Int
  points              Int
  ledgerTransactionId String           @unique
  createdAt           DateTime

  @@unique([distributionId, memberId])
  @@index([memberId, createdAt])
}

/// A continuous period with a negative POSTED balance (reservations never open one).
/// At most one open period (recoveredAt IS NULL) per member — enforced by a partial unique index.
model NegativeBalancePeriod {
  id                 String    @id @default(cuid())
  memberId           String
  member             Member    @relation(fields: [memberId], references: [id])
  /// When the posted balance crossed below zero.
  negativeSince      DateTime
  /// When it reached zero or above (period closed).
  recoveredAt        DateTime?
  /// Set once the >50-day reminder was sent for this period (never sent twice).
  reminderSentAt     DateTime?
  /// Member ids notified (friends), or the member's own id for a private reminder.
  reminderRecipients String[]  @default([])
  /// ledger (tracked live) | reconstructed (from ledger history) | migration (no history found)
  source             String
  createdAt          DateTime

  @@index([memberId, negativeSince])
}

// ───────────────────────── university circles ─────────────────────────

/// One shared chat room per university ("HKU Circle"). Created on first use.
model CircleRoom {
  id             String             @id @default(cuid())
  /// University code from packages/shared/src/universities.ts, e.g. "HKU".
  universityCode String             @unique
  name           String
  createdAt      DateTime
  memberships    CircleMembership[]
  messages       CircleMessage[]
}

/// Membership history. Access is always re-checked live (modules/verification); this row records how
/// and when someone joined or left. At most one open row (leftAt IS NULL) per member — partial unique index.
/// Joining a circle never creates friendships, vouches, credibility or relationship strength.
model CircleMembership {
  id         String     @id @default(cuid())
  roomId     String
  room       CircleRoom @relation(fields: [roomId], references: [id])
  memberId   String
  member     Member     @relation(fields: [memberId], references: [id])
  /// VERIFIED_EMAIL (genuine university email) | DEMO_SELF_DECLARED (demo mode, self-declared)
  via        String
  joinedAt   DateTime
  leftAt     DateTime?
  leftReason String?

  @@index([memberId])
  @@index([roomId, leftAt])
}

/// Persisted circle message. Kept when the author later switches university (history is preserved).
model CircleMessage {
  id        String     @id @default(cuid())
  roomId    String
  room      CircleRoom @relation(fields: [roomId], references: [id])
  authorId  String
  author    Member     @relation(fields: [authorId], references: [id])
  body      String
  tags      String[]   @default([])
  createdAt DateTime

  @@index([roomId, createdAt])
}

// ───────────────────────── audit & system ─────────────────────────

model AuditEvent {
  id            String   @id @default(cuid())
  /// Domain (possibly simulated) time of the change.
  occurredAt    DateTime
  /// Wall-clock time the row was written.
  recordedAt    DateTime @default(now())
  actorId       String?
  actor         Member?  @relation(fields: [actorId], references: [id])
  module        String
  action        String
  entityType    String
  entityId      String
  before        Json?
  after         Json?
  reason        String
  ruleId        String
  policyVersion String
  correlationId String
  summary       String
  /// Monotonic ordering inside one timestamp.
  seq           Int      @default(autoincrement())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([occurredAt])
}

/// Single-row table holding the demo clock.
model SystemState {
  id           Int       @id @default(1)
  simulatedNow DateTime?
  seededAt     DateTime?
  updatedAt    DateTime  @updatedAt
}
